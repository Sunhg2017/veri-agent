# WP9 web/API instance. Scheduler is disabled; webhook ingress may be enabled after smoke.
WP9_WORKER_HOSTING_ROLE=web
SPRING_PROFILES_ACTIVE=db,redis
PLATFORM_REDIS_ADDRESS=redis://redis:6379
PLATFORM_XXL_JOB_ENABLED=true
WP9_SCHEDULER_ENABLED=false
WP9_CRON_ENABLED=false
WP9_WEBHOOK_ENABLED=true
WP9_SCHEDULER_WORKER_ID=wp9-web-no-scheduler
WP9_SCHEDULER_INTERVAL_MS=5000
WP9_SCHEDULER_INITIAL_DELAY_MS=30000
WP9_SCHEDULER_TICK_BATCH_SIZE=4
WP9_MAX_CONCURRENT_NODES_PER_RUN=4
WP9_NODE_HEARTBEAT_TIMEOUT_SECONDS=180
WP9_RECOVERY_BATCH_SIZE=50
WP9_SCHEDULER_LEADER_LOCK_ENABLED=true
WP9_SCHEDULER_LEADER_LOCK_NAME=wp9:execution:scheduler:leader
WP9_SCHEDULER_LEADER_LOCK_WAIT_MS=0
WP9_SCHEDULER_LEADER_LOCK_LEASE_MS=120000
