# WP9 standby scheduler worker. Enable only during controlled failover.
WP9_WORKER_HOSTING_ROLE=scheduler-standby
PLATFORM_XXL_JOB_ENABLED=true
WP9_SCHEDULER_ENABLED=false
WP9_CRON_ENABLED=false
WP9_WEBHOOK_ENABLED=false
WP9_SCHEDULER_WORKER_ID=wp9-scheduler-standby-01
WP9_SCHEDULER_INTERVAL_MS=5000
WP9_SCHEDULER_INITIAL_DELAY_MS=30000
WP9_SCHEDULER_TICK_BATCH_SIZE=4
WP9_MAX_CONCURRENT_NODES_PER_RUN=4
WP9_NODE_HEARTBEAT_TIMEOUT_SECONDS=180
WP9_RECOVERY_BATCH_SIZE=50
