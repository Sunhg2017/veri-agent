{
  "openapi": "3.0.3",
  "info": {
    "title": "WP6 Secret Fixture API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "CredentialRequest": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "example": "sk-wp6-fixture-secret-value-000000"
          },
          "token": {
            "type": "string",
            "example": "Bearer wp6-fixture-bearer-secret"
          },
          "clientSecret": {
            "type": "string",
            "example": "fixture-client-secret"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/credentials": {
      "post": {
        "operationId": "createCredential",
        "tags": [
          "credentials"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Basic d3A2LWZpeHR1cmU6c2VjcmV0"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    }
  }
}
