{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veri-agent.local/schemas/testdesign/wp5-test-design-model-output.schema.json",
  "title": "WP5 Test Design Model Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "coverageType", "priority", "steps", "expectedResult"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "coverageType": {
            "type": "string",
            "enum": ["SMOKE", "FUNCTIONAL", "EXCEPTION", "BOUNDARY", "PERMISSION", "REGRESSION"]
          },
          "priority": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "preconditions": {
            "type": "string",
            "maxLength": 2000
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "expectedResult"],
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "expectedResult": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "expectedResult": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "requirementRef": {
            "type": "string",
            "maxLength": 128
          },
          "apiRefs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "pageRefs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "flowRefs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "riskNotes": {
            "type": "string",
            "maxLength": 2000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
