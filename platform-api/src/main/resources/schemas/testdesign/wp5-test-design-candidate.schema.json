{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veri-agent.local/schemas/testdesign/wp5-test-design-candidate.schema.json",
  "title": "WP5 Test Design Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "taskId",
    "projectId",
    "requirementId",
    "title",
    "coverageType",
    "priority",
    "status",
    "steps",
    "expectedResult",
    "duplicateKey",
    "confidence",
    "promptKey",
    "promptVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requirementId": {
      "type": "string",
      "format": "uuid"
    },
    "apiId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "coverageType": {
      "type": "string",
      "enum": ["SMOKE", "FUNCTIONAL", "EXCEPTION", "BOUNDARY", "PERMISSION", "REGRESSION"]
    },
    "priority": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "status": {
      "type": "string",
      "enum": ["GENERATED", "EDITED", "CONFIRMED", "REJECTED", "IGNORED", "PUBLISHED", "FAILED"]
    },
    "preconditions": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepOrder", "action", "expectedResult"],
        "properties": {
          "stepOrder": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expectedResult": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "expectedResult": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "duplicateKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "promptKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "modelInvocationId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "modelProviderName": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "modelName": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "assetCaseId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "reviewComment": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "rejectedReason": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "ignoredReason": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "errorMessage": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "confirmedBy": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "confirmedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
