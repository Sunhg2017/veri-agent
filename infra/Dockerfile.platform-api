# WP1 platform-api — Multi-stage Docker build
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build
COPY pom.xml ./
COPY platform-api/pom.xml ./platform-api/
RUN mvn dependency:go-offline -pl platform-api -am -q 2>/dev/null || true
COPY . .
RUN mvn package -pl platform-api -am -DskipTests -q -Dmaven.test.skip=true

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /build/platform-api/target/*.jar app.jar
# Copy DB migrations for Flyway filesystem access
COPY --from=builder /build/db/migration/wp1 ./db/migration/wp1
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
